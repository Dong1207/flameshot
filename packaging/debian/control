# KSystemClipboard đặt được clipboard trên Wayland mà không cần giữ focus,
# nên không phải mượn focus bằng cửa sổ ẩn như flameshotdaemon.cpp vẫn làm khi
# thiếu nó. Gói này chỉ có từ Ubuntu 26.04 / Debian 13; Ubuntu 24.04 mới dừng ở
# KF5 dựng trên Qt5, không nạp chung tiến trình Qt6 được.
#
# Viết thẳng vào đây thì bản 24.04 hỏng, mà viết dạng "A | B" thì apt thấy B đã
# cài sẵn nên bỏ qua A ở mọi nơi — cờ tắt lặng lẽ. Linux-pack.yml thay dòng
# đánh dấu dưới đây cho những bản phân phối thực sự có KF6.
#KF6_BUILD_DEP
Rules-Requires-Root: no
Standards-Version: 4.7.2
Homepage: https://flameshot.org/
Vcs-Browser: https://github.com/flameshot-org/flameshot
Vcs-Git: https://github.com/flameshot-org/flameshot.git

Package: flameshot
Architecture: any
# Ubuntu noble expanded shlibs are suffixed with t64 for Qt dependencies, later versions of Ubuntu reverted back without suffix so make it future proof
# ${shlibs:Depends},
Depends:
 ${misc:Depends},
# libKF6GuiAddons.so.6 là DT_NEEDED cứng khi build có KSystemClipboard. Vì
# ${shlibs:Depends} đang tắt, không khai ở đây thì gói cài xong vẫn không chạy
# nổi. debian/rules bơm giá trị, để rỗng ở bản build không có KF6.
 ${kf6:Depends},
 libc6 (>= 2.35),
 libgcc-s1 (>= 11),
 libstdc++6 (>= 11),
 hicolor-icon-theme,
 qt6-qpa-plugins (>= 6.2.4~),
 libqt6core6 (>= 6.2.4~),
 libqt6dbus6 (>= 6.2.4~),
 libqt6gui6 (>= 6.2.4~),
 libqt6network6 (>= 6.2.4~),
 libqt6widgets6 (>= 6.2.4~),
 libqt6svg6 (>= 6.2.4~),
